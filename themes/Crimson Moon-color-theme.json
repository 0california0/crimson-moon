	"tokenColors": [
		{
			"scope": [
				"comment",
				"punctuation.definition.comment"
			],
			"settings": {
				"foreground": "#3f1f1f",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"keyword",
				"keyword.control",
				"keyword.operator",
				"keyword.other",
				"storage.type",
				"storage.modifier"
			],
			"settings": {
				"foreground": "#CC0000",
				"fontStyle": "bold"
			}
		},
		{
			"scope": [
				"punctuation",
				"meta.brace",
				"meta.bracket"
			],
			"settings": {
				"foreground": "#5A2222"
			}
		},
		{
			"scope": [
				"string",
				"string.quoted",
				"string.template"
			],
			"settings": {
				"foreground": "#8B2222"
			}
		},
		{
			"scope": [
				"punctuation.definition.string"
			],
			"settings": {
				"foreground": "#8B2222"
			}
		},
		{
			"scope": [
				"constant.character.escape"
			],
			"settings": {
				"foreground": "#671515"
			}
		},
		{
			"scope": [
				"string.regexp"
			],
			"settings": {
				"foreground": "#CC2222"
			}
		},
		{
			"scope": [
				"punctuation.definition.group.regexp"
			],
			"settings": {
				"foreground": "#FF3333"
			}
		},
		{
			"scope": [
				"constant",
				"constant.language",
				"support.constant"
			],
			"settings": {
				"foreground": "#AA2222"
			}
		},
		{
			"scope": [
				"constant.numeric",
				"constant.language.boolean",
				"constant.language.null",
				"constant.language.undefined"
			],
			"settings": {
				"foreground": "#CC4444"
			}
		},
		{
			"scope": [
				"variable",
				"variable.other",
				"variable.other.readwrite"
			],
			"settings": {
				"foreground": "#C8C8C8"
			}
		},
		{
			"scope": [
				"variable.language",
				"variable.language.this",
				"variable.language.self"
			],
			"settings": {
				"foreground": "#CC0000",
				"fontStyle": "bold"
			}
		},
		{
			"scope": [
				"variable.parameter"
			],
			"settings": {
				"foreground": "#f08080",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"variable.other.attribute",
				"meta.member.access"
			],
			"settings": {
				"foreground": "#D09090"
			}
		},
		{
			"scope": [
				"entity.name.function",
				"meta.function-call",
				"support.function"
			],
			"settings": {
				"foreground": "#E06060"
			}
		},
		{
			"scope": [
				"meta.decorator",
				"punctuation.decorator",
				"entity.name.function.decorator"
			],
			"settings": {
				"foreground": "#CC0000",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"entity.name.class",
				"entity.name.type",
				"entity.other.inherited-class",
				"support.class",
				"support.type"
			],
			"settings": {
				"foreground": "#CC2222"
			}
		},
		{
			"scope": [
				"entity.name.type.interface"
			],
			"settings": {
				"foreground": "#8B0000",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"entity.name.module"
			],
			"settings": {
				"foreground": "#8B3333"
			}
		},
		{
